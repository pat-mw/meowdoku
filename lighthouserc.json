{
  "_comment": "Lighthouse 12 removed the PWA category, so the installability audits it used to run no longer exist. Installability is verified instead by the release checklist and by the e2e suite, which asserts the manifest, the icons and an active service worker.",
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "isSinglePageApplication": true,
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "emulatedFormFactor": "mobile"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": ["off"],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 1000000
          }
        ],
        "uses-responsive-images": ["off"],
        "unused-javascript": ["off"]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
